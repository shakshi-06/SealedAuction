  },
  "constraints": {
    "must": ["strict red, black, and white palette", "no neon accents", "no emoji in UI copy", "responsive and reduced-motion aware", "plain-language auction states"],
    "avoid": ["generic SaaS gradients", "excessive rounded cards", "fake privacy claims", "em dashes in product copy"]
  },
  "decisions": [
    { "date": "2026-09-28", "decision": "Use a restrained auction-house editorial system with hairline rules, dark ink surfaces, warm white type, and muted red for phase and action states." },
    { "date": "2026-09-28", "decision": "Use deliberate card hover, reveal, scan, and floating seal motion only where it explains state or materiality." },
    { "date": "2026-09-28", "decision": "Use 21st.dev card composition principles, adapted to the existing MUI and Midnight application architecture." }
  ],
  "evidence": ["skills.sh frontend-design", "21st-ui-build", "21st.dev card component patterns"]
