    "assets": [],
    "instructions": []
  },
  "design": {
    "colorMode": "dark",
    "colors": { "ink": "#0B0B0B", "paper": "#F4F1EC", "red": "#B3262D", "redSoft": "#D95C61", "line": "#2A2928" },
    "typography": { "display": "Space Grotesk", "body": "IBM Plex Sans", "data": "DM Mono" },
    "spacing": { "unit": 8, "container": "min(1380px, calc(100% - 40px))" },
    "radius": { "default": 2 },
